{
  "name": "smart-paie-client",
  "version": "1.0.0",
  "description": "Client Frontend pour SMART-PAIE — React 18 + Vite + TailwindCSS",
  "type": "module",
  "scripts": {
    "dev":     "vite --https",
    "build":   "vite build",
    "preview": "vite preview --https",
    "lint":    "eslint src --ext .ts,.tsx",
    "preinstall": "npx -y package-lock-json-parser fix || true"
  },
  "dependencies": {
    "react":             "^18.2.0",
    "react-dom":         "^18.2.0",
    "react-router-dom":  "^6.21.0",
    "axios":             "^1.6.2",
    "zustand":           "^4.4.7",
    "@tanstack/react-query": "^5.13.4",
    "react-hook-form":   "^7.48.2",
    "serve": "^14.2.4",
    "zod":               "^3.22.4",
    "@hookform/resolvers": "^3.3.2",
    "react-hot-toast":   "^2.4.1",
    "date-fns":          "^3.0.6",
    "@tanstack/react-table": "^8.11.2",
    "lucide-react":      "^0.303.0",
    "clsx":              "^2.0.0",
    "tailwind-merge":    "^2.1.0"
  },
  "devDependencies": {
    "@types/react":      "^18.2.43",
    "@types/react-dom":  "^18.2.17",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer":      "^10.4.16",
    "eslint":            "^8.55.0",
    "postcss":           "^8.4.32",
    "tailwindcss":       "^3.4.0",
    "typescript":        "^5.3.3",
    "vite":              "^5.0.8"
  }
